CPP  = ~/gccsdk/cross/bin/arm-unknown-riscos-g++
ELF2AIF = ~/gccsdk/cross/bin/elf2aif

CXXFLAGS = -mcpu=arm6 -O3 -DSYS_LITTLE_ENDIAN -DBYPASS_PROTECTION -DVIDEO_LITTLE_ENDIAN -DUSE_ASM_PLOT_CODE
OBJ = bank.o engine.o file.o main.o mixerArc.o mixerArcAsm.o parts.o resource.o serializer.o sfxplayer.o staticres.o sysArc.o sysArcAsm.o util.o video.o videoArc.o vm.o

!RunImage,ff8: $(OBJ)
	$(CPP) $(CXXFLAGS) $(OBJ) -static -o "!RunImage,ff8"
	$(ELF2AIF) "!RunImage,ff8"

all : !RunImage,ff8

clean :
	rm *.o
	rm !RunImage,ff8

%.o : %.cpp
	$(CPP) $(CXXFLAGS) -c $<

%.o : %.s
	$(CPP) $(CXXFLAGS) -c $<

